<Window
    x:Class="EF_Core.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:EF_Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="EF Core WPF Example"
    MinWidth="800"
    MinHeight="450"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>


        <StackPanel
            Grid.Row="0"
            Margin="5"
            Orientation="Horizontal">
            <Button
                Name="AddCategoryButton"
                Margin="2"
                Click="AddCategory_Click"
                Content="Добавить категорию" />
            <Button
                Name="DeleteCategoryButton"
                Margin="2"
                Click="DeleteCategory_Click"
                Content="Удалить категорию" />
            <Button
                Name="SaveCategoryButton"
                Margin="2"
                Click="SaveCategories_Click"
                Content="Сохранить изменения" />
            <Button Name="ResetCategoryButton"
                    Margin="2"
                    Click="ResetCategories_Click"
                    Content="Восстановить категории" />
        </StackPanel>


        <DataGrid
            Name="categoryDataGrid"
            Grid.Row="1"
            Margin="5"
            AutoGenerateColumns="False"
            SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding CategoryId}"
                    Header="ID"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Width="5*"
                    Binding="{Binding Name}"
                    Header="Название" />
            </DataGrid.Columns>
        </DataGrid>


        <StackPanel
            Grid.Row="2"
            Margin="5"
            Orientation="Horizontal">
            <Button
                Name="AddProductButton"
                Margin="2"
                Click="AddProduct_Click"
                Content="Добавить товар" />
            <Button
                Name="DeleteProductButton"
                Margin="2"
                Click="DeleteProduct_Click"
                Content="Удалить товар" />
            <Button
                Name="SaveProductButton"
                Margin="2"
                Click="SaveProducts_Click"
                Content="Сохранить изменения" />
            <Button Name="ResetProductButton"
                    Margin="2"
                    Click="ResetProducts_Click"
                    Content="Восстановить товары" />
        </StackPanel>


        <DataGrid
            Name="productDataGrid"
            Grid.Row="3"
            Margin="5"
            AutoGenerateColumns="False"
            SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding ProductId}"
                    Header="ID"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Width="2*"
                    Binding="{Binding Name}"
                    Header="Название" />
                <DataGridTextColumn
                    Width="3*"
                    Binding="{Binding CategoryId}"
                    Header="ID Категории" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>

